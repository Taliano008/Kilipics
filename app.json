{
  "expo": {
    "name": "KiliPicks",
    "slug": "kilipicks-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kilipicks",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image",
      "./plugins/withWhatsAppQuery.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "KiliPicks uses your photos to add pictures of your business.",
          "cameraPermission": "KiliPicks uses your camera to take pictures of your business."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "kilimax-s5"
        }
      ],
      "expo-video"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kilimax.kilipicks"
    },
    "android": {
      "package": "com.kilimax.kilipicks",
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo.png",
        "backgroundColor": "#F8F4F1"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icons/logo.png",
    "splash": {
      "image": "./assets/icons/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F4F1"
    },
    "assetBundlePatterns": [
      "./assets/**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c224de84-db46-4e06-b7e9-6e43888cb948"
      }
    },
    "owner": "talianos-team"
  }
}
