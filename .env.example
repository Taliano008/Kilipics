# KiliPicks backend (backend/). Leave unset in development: the app finds the
# backend on the same computer as Expo automatically (port 3000, via the
# address Expo Go connected to). Set it to a deployed URL for a real build.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Must match ANALYTICS_APP_TOKEN in backend/.env, or analytics events are
# rejected (npm run init:env in backend/ prints it).
# EXPO_PUBLIC_ANALYTICS_APP_TOKEN=

# Support WhatsApp number — leave unset until the product owner supplies it.
# When set, the Account tab's "Get help" row will open a WhatsApp chat with
# this number (international format, no "+" prefix).
# EXPO_PUBLIC_SUPPORT_WHATSAPP_NUMBER=

# Sentry DSN for crash/error reporting. Get this from Sentry > Settings >
# Projects > (project) > Client Keys (DSN). Leave unset to disable Sentry.
# EXPO_PUBLIC_SENTRY_DSN=

# Built-in sample catalog instead of the backend's. Must stay false or unset
# for any build a real user will install — the build-time assertion in
# app.config.ts enforces this for EAS builds.
EXPO_PUBLIC_USE_MOCK_CATALOG=false
