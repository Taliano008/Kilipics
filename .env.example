EXPO_PUBLIC_API_BASE_URL=https://nairobi-local-picks-demo.hantianyang5.chatgpt.site
# For a physical device, use your computer's LAN address instead of localhost.
# EXPO_PUBLIC_AUTH_API_BASE_URL=http://192.168.1.20:3001
# Support WhatsApp number — leave unset until the product owner supplies it.
# When set, the Account tab's "Get help" row will open a WhatsApp chat with
# this number (international format, no "+" prefix).
# EXPO_PUBLIC_SUPPORT_WHATSAPP_NUMBER=

EXPO_PUBLIC_USE_MOCK_CATALOG=true
# DEMO CATALOG IS ON BY DEFAULT FOR INTERNAL BUILDS.
# This MUST remain false or unset for any build submitted to Play
# Closed Testing or any build a real seed user will install.
# The build-time assertion script enforces this — do not remove it.
