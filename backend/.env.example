# Server
PORT=3000
NODE_ENV=development

# Database — Supabase Postgres. Supabase dashboard -> Connect -> "Session pooler"
# connection string, with [YOUR-PASSWORD] replaced by the database password
# (Project Settings -> Database -> Reset database password if you don't have it).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=true

# Auth
JWT_SECRET=change-this-to-a-long-random-string-before-any-real-use
JWT_EXPIRES_IN=90d

# Admin panel — runs as its own process (npm run admin:dev), own port.
ADMIN_EMAIL=admin@kilipicks.com
ADMIN_PASSWORD=change-this-before-use
ADMIN_PORT=3050

# Analytics
ANALYTICS_APP_TOKEN=change-this-to-a-long-random-string

# File storage
UPLOADS_DIR=./uploads
# Keep relative: the app resolves /uploads/... against whatever backend
# address it's using. A full URL (http://<ip>:3000/...) breaks when the IP changes.
UPLOADS_BASE_URL=/uploads

# Photo storage in production — Supabase Storage. Create a PUBLIC bucket
# (Supabase dashboard -> Storage -> New bucket), then set all three. With
# any of them blank, uploads fall back to UPLOADS_DIR on local disk, which
# is lost on redeploy on most hosts.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role. It
# bypasses row-level security — server only, never put it in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Browser origins allowed to call the API, comma-separated (the mobile app
# needs none). Empty = no websites in production, any origin in development.
CORS_ORIGINS=

# Number of reverse proxies in front of the API (load balancer, host router,
# CDN). Needed in production so rate limits apply per user rather than to
# everyone at once. Most single-service hosts (Render, Railway, Fly) = 1.
# Leave at 0 when running directly, e.g. locally.
TRUST_PROXY_HOPS=0
