{
  "name": "kilipicks-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js,json,sql src/app.js",
    "start": "node src/app.js",
    "admin:dev": "nodemon --watch src --ext js,json,sql src/admin/server.js",
    "admin:start": "node src/admin/server.js",
    "migrate": "node migrations.js",
    "migrate:status": "node migrations.js --status",
    "init:env": "node scripts/init-env.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:open-now": "node scripts/check-open-now.mjs"
  },
  "dependencies": {
    "@adminjs/fastify": "3.0.1",
    "@adminjs/sql": "^2",
    "@fastify/cors": "^9",
    "@fastify/multipart": "^8",
    "@fastify/rate-limit": "^9",
    "@fastify/static": "^7",
    "adminjs": "^7",
    "bcrypt": "^5",
    "dotenv": "^16",
    "fastify": "^4",
    "mysql2": "^3",
    "ulid": "^2"
  },
  "devDependencies": {
    "nodemon": "^3"
  }
}
